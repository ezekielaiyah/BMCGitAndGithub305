l, sans-serif; }

#facebook .system-fonts--body div, #facebook .system-fonts--body span, #fac=
ebook .system-fonts--body a, #facebook .system-fonts--body h1, #facebook .s=
ystem-fonts--body h2, #facebook .system-fonts--body h3, #facebook .system-f=
onts--body h4, #facebook .system-fonts--body h5, #facebook .system-fonts--b=
ody h6, #facebook .system-fonts--body p, #facebook .system-fonts--body butt=
on, #facebook .system-fonts--body input, #facebook .system-fonts--body labe=
l, #facebook .system-fonts--body select, #facebook .system-fonts--body td, =
#facebook .system-fonts--body textarea { font-family: inherit; }

